# Copy to .env and fill in. .env is gitignored.

# --- Database -----------------------------------------------------------
# MongoDB Atlas connection string.
MONGO_URI=

# --- Encryption ---------------------------------------------------------
# MUST be exactly 32 characters. Every metric model throws on startup
# otherwise, and changing it makes existing rows undecryptable.
# See scripts/README.md before rotating.
ENCRYPTION_KEY=

# --- Clerk (auth) -------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Email --------------------------------------------------------------
RESEND_API_KEY=

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:4000
GA_ID=

# Gates /api/seed/[userId]. Note the route currently only checks this when
# the field is present -- see docs/BUGS.md #1.
SEED_TOKEN=

# --- Payments -----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Legacy (pre-Clerk JWT auth; not used by the current app) -----------
TOKEN_SECRET=
DOMAIN=http://localhost:4000
